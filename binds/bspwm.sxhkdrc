# ============================================================================
# karui-oto · binds/bspwm.sxhkdrc — paste into ~/.config/sxhkd/sxhkdrc
# Or run: karui-oto binds --apply bspwm
# Reload: pkill -USR1 sxhkd. Matches `karui-oto binds bspwm`.
# ============================================================================
super+o
    ~/.local/bin/karui-oto songs
super+p
    ~/.local/bin/karui-oto artists
super+shift+p
    ~/.local/bin/karui-oto albums
super+shift+o
    ~/.local/bin/karui-oto folders
super+x
    ~/.local/bin/karui-oto kill
XF86AudioNext
    ~/.local/bin/karui-media next
XF86AudioPrev
    ~/.local/bin/karui-media prev
XF86AudioPlay
    ~/.local/bin/karui-media play-pause
